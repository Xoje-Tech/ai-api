# AI API Keys
#
# In the Hermes ecosystem, these are loaded from Bitwarden Secrets Manager
# via GPG-decrypted BWS tokens — see README.md → Deployment.
#
# For standalone development, fill in the values below. Never commit secrets.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Database Configuration (PostgreSQL)
# Only required for /users CRUD with a real DB.
# When unset, the server falls back to InMemoryUserRepository.
DATABASE_URL=postgres://username:password@localhost:5432/database_name

# Server Port
PORT=3000
