# AI API Keys
#
# In the Hermes ecosystem, these are loaded from Bitwarden Secrets Manager
# via GPG-decrypted BWS tokens — see README.md → Deployment.
#
# For standalone development, fill in the values below. Never commit secrets.
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Auth — required for /v1/* routes. Generate with: openssl rand -hex 32
AI_API_KEY=
# Bind address — loopback by default. Set AI_API_ALLOW_PUBLIC=true to expose publicly.
AI_API_HOST=127.0.0.1
AI_API_ALLOW_PUBLIC=false

# Server Port
PORT=5678