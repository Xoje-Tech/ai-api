{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ai-balancer/*": ["src/modules/ai-balancer/*"],
      "@users/*": ["src/modules/users/*"],
      "@shared/*": ["src/modules/shared/*"]
    }
  }
}
