{
  "name": "ai-api",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pr:create": "bash scripts/safe-pr.sh",
    "typecheck": "tsc --noEmit",
    "knowledge:regen": "tsx scripts/regenerate-knowledge.ts",
    "knowledge:lint": "tsx scripts/lint-knowledge-bundle.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/modules/*/infrastructure/adapters/*.ts": "pnpm exec tsx scripts/regenerate-knowledge.ts --target adapters",
    "src/modules/*/interface/routes/*.ts": "pnpm exec tsx scripts/regenerate-knowledge.ts --target api",
    ".env.example": "pnpm exec tsx scripts/regenerate-knowledge.ts --target env"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@openrouter/sdk": "0.9.11",
    "groq-sdk": "0.37.0",
    "hono": "4.12.27",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "4.1.9",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "4.1.9"
  }
}